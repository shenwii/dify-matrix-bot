# Matrix Configuration
MATRIX_HOMESERVER=https://matrix.example.org
MATRIX_USER_ID=@bot:example.org
# Prefer MATRIX_ACCESS_TOKEN; if omitted, MATRIX_PASSWORD will be used to log in
MATRIX_ACCESS_TOKEN=
MATRIX_PASSWORD=
MATRIX_DEVICE_ID=DIFY_MATRIX_BOT
MATRIX_AUTO_JOIN=true
# End-to-End Encryption (E2EE) settings
MATRIX_E2EE_ENABLED=true
MATRIX_STORE_PATH=/app/data/crypto_store
MATRIX_TRUST_ALL_DEVICES=true
# Number of recent group messages from all participants exposed as $history
MATRIX_GROUP_CONTEXT_LIMIT=10
# Optional command prefix to trigger the bot in group chats (in addition to @mentions)
MATRIX_COMMAND_PREFIX=
# Typing indicator refresh interval (seconds) and server timeout (ms)
MATRIX_TYPING_INTERVAL_SECONDS=15
MATRIX_TYPING_TIMEOUT_MS=30000

# Dify Configuration
DIFY_BASE_URL=https://api.dify.ai/v1
DIFY_API_KEY=app-xxxxxxxxxxxxxxxxxxxxxxxx
DIFY_TIMEOUT_SECONDS=180
DIFY_SCHEDULED_USER=dify-scheduler
# JSON template for Dify /chat-messages "inputs" during Matrix chat
# Available variables: $user_id, $user_name, $user_localpart, $room_id, $room_name, $is_group, $source, $history
# (JSON keys can be customized to match your Dify app's input variable names)
DIFY_INPUTS={"user_id":"$user_id","user_name":"$user_name","room_id":"$room_id","source":"matrix","history":"$history"}
# JSON template for Dify /chat-messages "inputs" when triggered by the scheduler
# Available variables: $user_id, $user_localpart, $room_id, $task_uuid, $task_title
DIFY_SCHEDULER_INPUTS={"user_id":"$user_id","room_id":"$room_id"}

# Scheduler Timezone (standard TZ) & Storage
TZ=Asia/Shanghai
DATABASE_PATH=/app/data/bot.db

# Server & MCP Security
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
# Optional Bearer token to protect MCP SSE endpoints (/sse and /messages/)
MCP_AUTH_TOKEN=
# Optional comma-separated Host header allowlist for MCP SSE (leave empty to allow all hosts)
MCP_ALLOWED_HOSTS=
